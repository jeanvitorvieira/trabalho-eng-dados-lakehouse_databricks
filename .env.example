# Database source (PostgreSQL / Supabase)
# No Databricks essas credenciais ficam no Secret Scope "lakehouse" (chaves em minúsculo:
# db_host, db_port, db_name, db_user, db_password) ou em parâmetros do Job. O .env serve só para testes locais.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA_LANDING=landing
DATABRICKS_SCHEMA_BRONZE=bronze
DATABRICKS_SCHEMA_SILVER=silver
DATABRICKS_SCHEMA_GOLD=gold
